# ── Database ──
DATABASE_URL="postgresql://vlab:vlab@localhost:5432/vlab?schema=public"

# ── App ──
APP_URL="http://localhost:3000"
# Set true in production behind HTTPS so cookies are Secure
COOKIE_SECURE="false"
SESSION_TTL_HOURS="12"

# ── Code execution ──
# "runner"  → JECRC sandbox runner service (services/runner, deploy in its own hardened container)
# "judge0"  → Judge0 CE / Judge0 RapidAPI
EXECUTION_PROVIDER="runner"
RUNNER_URL="http://localhost:4100"
RUNNER_SECRET="change-me-long-random-string"
# Judge0 (only if EXECUTION_PROVIDER=judge0)
JUDGE0_URL="https://judge0-ce.p.rapidapi.com"
JUDGE0_API_KEY=""
JUDGE0_API_HOST="judge0-ce.p.rapidapi.com"

# ── File storage ──
# Project uploads. Only "local" is implemented: files are stored under STORAGE_DIR (mount a persistent volume in production).
# The S3_* variables are reserved for a future S3-compatible driver and are currently unused.
STORAGE_DIR="./storage"
STORAGE_DRIVER="local"
S3_ENDPOINT=""
S3_REGION="ap-south-1"
S3_BUCKET="jecrc-vlab"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
MAX_UPLOAD_MB="20"
