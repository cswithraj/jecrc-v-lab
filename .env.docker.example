# Copy to .env.docker and fill in. Never commit the real file.
POSTGRES_DB=vlab
POSTGRES_USER=vlab
POSTGRES_PASSWORD=change-me-long-random
RUNNER_SECRET=change-me-at-least-24-random-characters
APP_URL=http://localhost
# Set to true only for a demo install (creates demo accounts with password Demo@1234).
SEED_DEMO=false
# Use false only when serving over plain HTTP (local trial). Behind HTTPS keep true.
COOKIE_SECURE=false
HTTP_PORT=80
RUNNER_CONCURRENCY=4
